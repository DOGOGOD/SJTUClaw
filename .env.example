# ============================================================================
# SJTUClaw 配置文件
# 复制此文件为 .env 并填写实际值：cp .env.example .env
# .env 已在 .gitignore 中排除，切勿将含有真实密钥的 .env 提交到仓库
# ============================================================================

# ============================================================================
# 必需：LLM 服务
# ============================================================================
# API 密钥（OpenAI 兼容接口）。支持 OpenAI / vLLM / Ollama / LM Studio 等
LLM_API_KEY=sk-your-api-key-here
# API 基础地址。OpenAI 官方: https://api.openai.com/v1
LLM_BASE_URL=https://api.openai.com/v1
# 模型名称。如 gpt-4o / gpt-4o-mini / claude-sonnet-4-20250514 / deepseek-chat
LLM_MODEL=gpt-4o

# 主 Agent 后端：sjtuclaw（默认）、pi 或 claude
# AGENT_BACKEND=claude
# Claude Code 会自动从 PATH、官方原生安装目录和 npm 常见目录检索
# CLAUDE_CODE_PATH=C:\\Users\\your-name\\.local\\bin\\claude.exe
# CLAUDE_CODE_COMMAND=claude
# CLAUDE_CODE_MODEL=sonnet
# Claude Code 原生权限模式，默认 default；危险操作仍会进入 SJTUClaw 审批
# CLAUDE_CODE_PERMISSION_MODE=default
# CLAUDE_CODE_CWD=C:\\path\\to\\workspace
# CLAUDE_CODE_TURN_TIMEOUT_S=1800
# 跳过 SJTUClaw 与 Claude Code 权限审批，仅限完全可信环境
# CLAUDE_CODE_TRUST_TOOLS=false
#
# Pi 可选配置
# AGENT_BACKEND=pi
# PI_COMMAND=node C:\\path\\to\\pi\\packages\\coding-agent\\dist\\cli.js
# PI_CLI_PATH=C:\\path\\to\\pi\\packages\\coding-agent\\dist\\cli.js
# PI_NODE_PATH=C:\\Program Files\\nodejs\\node.exe
# PI_REPO_DIR=C:\\path\\to\\pi
# PI_SHELL_PATH=C:\\Program Files\\Git\\bin\\bash.exe
# PI_PROVIDER=openai
# PI_MODEL=gpt-5.2-codex
# PI_THINKING=high
# 使用现有 LLM_* 作为 Pi 的 OpenAI-compatible provider 时，按需开启 reasoning：
# PI_REASONING=false
# PI_CWD=C:\\path\\to\\workspace
# PI_AGENT_DIR=C:\\path\\to\\pi-agent-config
# PI_SESSION_DIR=C:\\path\\to\\pi-sessions
# PI_TURN_TIMEOUT_S=1800
# PI_TRUST_TOOLS=false

# ============================================================================
# microsandbox 隔离运行（SJTUClaw 原生 Agent）
# ============================================================================
# off（默认）：新 session 不自动使用 microsandbox，可通过 /sandbox on 单独开启
# auto：检测到 microsandbox 时自动使用；未安装时保持原有 workspace 行为
# required：必须使用 microVM，任何启动失败都拒绝回退到宿主
SANDBOX_MODE=off
# 推荐镜像；首次使用前运行 packaging/sandbox/Build-SandboxImage.ps1 构建并导入
# 若尚未构建，可临时改用 python:3.12-bookworm，但不会预装通用库
SANDBOX_IMAGE=sjtuclaw-sandbox:py3.12-bookworm
# 创建运行 venv，并把项目包和命令同步到 workspace 的 .venv 持久目录
SANDBOX_PROJECT_VENV=true
# 项目依赖安装源；留空则遵循镜像或 pip 自身配置
SANDBOX_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SANDBOX_CPUS=2
SANDBOX_MEMORY_MIB=2048
SANDBOX_MAX_DURATION_S=21600
SANDBOX_IDLE_TIMEOUT_S=3600
# public 允许开发依赖下载；none 完全关闭 guest 网络
SANDBOX_NETWORK=public
# restricted（推荐）或 default
SANDBOX_SECURITY=restricted
# auto（Windows: relaxed+mirror，其他: strict）、strict、relaxed 或 off
SANDBOX_STAT_VIRTUALIZATION=auto
# guest 对私有卷或已绑定 workspace 的新增写入配额
SANDBOX_WORKSPACE_QUOTA_MIB=4096

# ============================================================================
# Workspace Rollback 快照预算
# ============================================================================
# 增量缓存会复用未变化文件的哈希与快照对象，以下预算只限制需要新读取的内容。
# 超出预算的检查点会安全降级为“部分快照”，不会据此删除未完整扫描的路径。
ROLLBACK_MAX_FILES=100000
# 单个文件上限，单位字节（默认 128 MiB）
ROLLBACK_MAX_FILE_BYTES=134217728
# 单次检查点最多新读取的数据量，单位字节（默认 256 MiB）
ROLLBACK_MAX_SNAPSHOT_BYTES=268435456
# 单次 Workspace 扫描时间上限，单位秒
ROLLBACK_SCAN_TIMEOUT_S=5
# 新文件哈希与对象写入并发数（1-16）
ROLLBACK_SCAN_WORKERS=4

# ============================================================================
# 上下文窗口
# ============================================================================
# 模型的上下文窗口大小（token），默认 32000
# 用于计算有效 token 预算和触发上下文压缩
LLM_CONTEXT_WINDOW=32000

# 上下文利用率上限（0.0 ~ 1.0），默认 0.80
# 当上下文 token 数超过 window * ratio 时触发上下文压力告警，建议执行 /compact
LLM_CONTEXT_USAGE_RATIO=0.80

# 预留输出 token 数，默认 4096
# 从 context_window 中预留给模型输出的空间
LLM_MAX_OUTPUT_TOKENS=4096

# 多轮合并目标比例，默认 0.5
# 上下文触发压缩时，目标将消息 token 数压缩到 input_budget * ratio
LLM_CONSOLIDATION_RATIO=0.50

# ============================================================================
# LLM 调用可靠性与性能
# ============================================================================
# API 调用失败时的最大重试次数，默认 2
# 仅对瞬态错误生效：网络超时、连接重置、429 限流、5xx 服务端错误
# 设为 0 禁用自动重试
LLM_MAX_RETRIES=2

# 重试基础延迟（秒），默认 1.0
# 使用指数退避策略：第 n 次重试延迟 = base_delay * 2^(n-1)
LLM_RETRY_BASE_DELAY=1.0

# 单次 API 请求超时（秒），默认 120
# 防止因网络问题导致的无限等待
LLM_REQUEST_TIMEOUT=120

# ============================================================================
# 上下文压缩 (Compaction)
# ============================================================================
# 自动压缩仅在消息 token 达到阈值后触发；也可使用 /compact 手动压缩
# 会话空闲不会触发自动压缩
# 消息 token 数超过此值时触发压缩，默认 2000
COMPACT_MAX_MESSAGE_TOKENS=2000

# 压缩时保留最近消息的 token 预算，默认 1000
COMPACT_KEEP_RECENT_TOKENS=1000

# 压缩时至少保留的消息条数，默认 4
# 无论 token 预算如何，始终保留最近 N 条消息不被压缩
COMPACT_KEEP_RECENT_MESSAGES_MIN=4

# ---- 独立压缩模型（可选）----
# 不配置则复用主模型的 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL
# 配置独立模型可降低压缩成本（例如使用 gpt-4o-mini 替代 gpt-4o）
# COMPACT_LLM_API_KEY=
# COMPACT_LLM_BASE_URL=
# COMPACT_LLM_MODEL=

# ============================================================================
# Agent Loop 配置
# ============================================================================
# 单轮工具调用次数上限，默认 20
# 超过此数量时自动截断并提示模型总结
CLAW_MAX_TOOL_CALLS_PER_TURN=20

# Agent 循环最大迭代次数，默认 15
# 达到上限后强制模型生成无工具最终回答
CLAW_MAX_AGENT_ITERATIONS=15

# 用户可见时间/定时任务默认时区。留空时自动识别系统时区；识别失败回退 Asia/Shanghai
# 可显式指定 IANA 时区，如 Asia/Shanghai、America/New_York、Europe/Paris
# CLAW_TIMEZONE=

# ============================================================================
# 原生联网工具（web_search / web_fetch）
# ============================================================================
# 默认启用；设为 false 可完全移除联网工具
WEB_TOOL_ENABLED=true
# 单次请求超时、最大响应体和瞬时故障重试次数
WEB_TIMEOUT_SECONDS=15
WEB_MAX_RESPONSE_BYTES=2097152
WEB_MAX_RETRIES=2
# 可选。配置后优先使用 Tavily；未配置时使用 DuckDuckGo，并回退到 Bing
# TAVILY_API_KEY=
# 出于 SSRF 防护考虑默认不读取系统代理；确有需要时可显式开启
WEB_TRUST_ENV_PROXY=false

# ============================================================================
# 历史日志
# ============================================================================
# 会话历史日志最大条目数，默认 2000
# 超过上限时自动归档旧条目
HISTORY_MAX_ENTRIES=2000

# ============================================================================
# Heartbeat 心跳监控
# ============================================================================
# 是否启用定期检查 workspace 中 HEARTBEAT.md 的活跃任务，默认启用
HEARTBEAT_ENABLED=true

# 心跳检查间隔（秒），默认 1800（30 分钟）
HEARTBEAT_INTERVAL_S=1800

# 心跳任务触发时，Agent Loop 保留的最近消息条数，默认 8
HEARTBEAT_KEEP_RECENT=8

# ============================================================================
# Gateway HTTP 服务
# ============================================================================
# 仅在使用 python -m claw.gateway 时生效
# Gateway 监听地址，默认 127.0.0.1（仅本机访问）
# 如需局域网访问可设为 0.0.0.0，并必须同时设置 GATEWAY_API_TOKEN
# GATEWAY_HOST=127.0.0.1
# GATEWAY_API_TOKEN=请替换为至少32字符的随机令牌
# GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Gateway 监听端口，默认 8000
# GATEWAY_PORT=8000

# 启动时是否自动打开浏览器访问 Web UI
# GATEWAY_OPEN_BROWSER=false

# ============================================================================
# 网络代理（QQ Bot WebSocket 连接使用）
# ============================================================================
# 按优先级依次尝试：WSS_PROXY → HTTPS_PROXY → ALL_PROXY
# 仅在 QQ Bot 需要穿透公司防火墙/代理时配置
# WSS_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=

# ============================================================================
# QQ 机器人（官方 QQ Bot API v2）
# ============================================================================
# 获取凭证两种方式：
#   1. 扫码获取:  python -m claw.channels.qq_onboard
#   2. 手动创建: 前往 QQ 开放平台 https://q.qq.com 创建机器人应用
#      然后进入开发设置 → 获取 AppID 和 AppSecret（ClientSecret）

# 是否启用 QQ 机器人通道
QQ_ENABLED=false

# QQ Bot AppID（从 QQ 开放平台获取）
QQ_APP_ID=

# QQ Bot ClientSecret（即 AppSecret，从 QQ 开放平台获取）
QQ_CLIENT_SECRET=

# 允许的使用者 QQ OpenID，用英文逗号分隔多个
# 设为 * 允许所有用户（不推荐用于生产环境）
# 示例: QQ_ALLOW_FROM=ABC123,DEF456
# 留空表示拒绝所有用户；生产环境请填写明确的 OpenID，避免使用通配符
QQ_ALLOW_FROM=

# 消息格式：markdown（支持加粗/代码块等）或 text（纯文本）
QQ_MSG_FORMAT=markdown

# 收到消息时的确认回复（留空则不发送）
# 示例: QQ_ACK_MESSAGE=⏳ 处理中...
# QQ_ACK_MESSAGE=

# QQ 开放平台 Portal 域名，默认 q.qq.com
# 企业内网环境可能需要修改
# QQ_PORTAL_HOST=q.qq.com

# 附件保存目录（留空使用默认 data/media/qq/）
# QQ_MEDIA_DIR=
